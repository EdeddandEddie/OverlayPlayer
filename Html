<!DOCTYPE html>
<html>
<head>
    <style>
        body { margin: 0; background: transparent; font-family: sans-serif; color: white; }
        #player-container { width: 640px; height: 360px; background: black; }
        #title { padding: 10px; background: rgba(0,0,0,0.8); font-size: 20px; text-transform: uppercase; }
    </style>
</head>
<body>
    <div id="title">ESPERANDO MÚSICA...</div>
    <div id="player"></div>

    <script src="https://www.youtube.com/iframe_api"></script>
    <script>
        const API_KEY = "AIzaSyDr4x1o4-ZvkTY6h5pRSVR6gnf11fL_vfc";
        let player;

        function onYouTubeIframeAPIReady() {
            player = new YT.Player('player', { height: '360', width: '640', videoId: 'dQw4w9WgXcQ' });
        }

        async function updateTitle(videoId) {
            const url = `https://www.googleapis.com/youtube/v3/videos?part=snippet&id=${videoId}&key=${API_KEY}`;
            const response = await fetch(url);
            const data = await response.json();
            if (data.items.length > 0) {
                document.getElementById('title').innerText = data.items[0].snippet.title;
            }
        }
    </script>
window.addEventListener("message", (event) => {
    if (event.data.type === "play") {
        player.loadVideoById(event.data.videoId);
        document.getElementById('title').innerText = "Reproduciendo...";
    }
});
</body>
</html>
